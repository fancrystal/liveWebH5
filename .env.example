# ══════════════════════════════════════════════════════════════════════════════
#                    liveAssistantH5 — 环境变量配置模板
# ══════════════════════════════════════════════════════════════════════════════
#
# 多环境切换:
#   本地开发 → npm run dev        → 加载 .env.development + .env
#   测试构建 → npm run build:test → 加载 .env.test         + .env
#   生产构建 → npm run build:prod → 加载 .env.production    + .env
#
# 只有 VITE_ 前缀的变量会被注入到客户端 JS 中。
# NGINX_ 前缀的变量是容器运行时变量，不参与构建（见 nginx.template.conf）。
# ══════════════════════════════════════════════════════════════════════════════

# ── 部署环境标识 ────────────────────────────────────────────────────────────
# development | test | production（每个 .env.<mode> 里设置对应的值）
VITE_APP_ENV=development

# ── 腾讯云 IM ─────────────────────────────────────────────────────────────────
# SDKAppID，来自腾讯云 IM 控制台（固定值，所有环境相同）
VITE_IM_SDK_APP_ID=1600113763
# IM REST API 基地址（格式: https://host:port）
VITE_IM_BASE_URL=

# ── SaaS 业务接口 ─────────────────────────────────────────────────────────────
# 换 token / 直播间详情 / 云盘等接口共用的基地址
VITE_SASS_URL=

# ── 推流服务 ──────────────────────────────────────────────────────────────────
VITE_SIGNAL_URL=
VITE_RTMP_WS_URL=
VITE_WHIP_URL=

# ── 调试开关 ──────────────────────────────────────────────────────────────────
VITE_VERBOSE_LOG=false
VITE_PUSH_URL_EDITABLE=false
VITE_DEV_TOKEN=
VITE_DEV_ROOM_ID=
VITE_DEV_USER_ID=
