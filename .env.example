# SaaS API base URL (shared by /livesaas/exchange token swap and cloud-drive APIs)
# Format: https://host:port (no trailing slash)
VITE_SASS_URL=https://qdd-test.lxi-tech.com:15816

# Signal server (socket.io)
VITE_SIGNAL_URL=http://localhost:3001

# RTMP relay WebSocket endpoint
VITE_RTMP_WS_URL=ws://localhost:8080/rtmp-relay

# WHIP endpoint (SRS or other WebRTC server)
VITE_WHIP_URL=http://localhost:1985/rtc/v1/whip/?app=live&stream=test

# Verbose diagnostic logs (Mixer ticks, RTMP chunks/s).
# Leave empty/false in production to keep the console clean.
VITE_VERBOSE_LOG=true
