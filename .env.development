# ── 推流服务 ──────────────────────────────────────────────────────────────────
VITE_SIGNAL_URL=http://localhost:3001
VITE_RTMP_WS_URL=ws://localhost:8080/rtmp-relay
VITE_WHIP_URL=http://localhost:1985/rtc/v1/whip/?app=live&stream=test
VITE_VERBOSE_LOG=true

# ── 腾讯IM ───────────────────────────────────────────────────────────────────
# 腾讯云 IM 应用 SDKAppID（生产环境也应配置，避免硬编码在源码中）
VITE_IM_SDK_APP_ID=1600113763
# IM REST API 基地址（测试环境网关映射到 15830，生产按实际配置）
VITE_BASE_URL_9085=https://qdd-test.lxi-tech.com:15830

# ── SaaS 接口基地址 ───────────────────────────────────────────────────────────
# 换 token 接口 (/livesaas/exchange) 和云盘等业务接口共用此基地址
# 格式：https://host:port（结尾不要带斜杠）
VITE_SASS_URL=https://qdd-test.lxi-tech.com:15816

# ── 云盘 Mock（开发调试用，生产通过 URL 参数注入）────────────────────────────
# 旧的开发兜底地址，留空则回退到 VITE_SASS_URL
VITE_DEV_SASS_URL=

# 填入你在管理后台登录后的 token（抓包或 DevTools → Application → Cookie/Storage 查看）
VITE_DEV_TOKEN=

# 填入要测试的直播间 ID
VITE_DEV_ROOM_ID=

# 填入你的 userId
VITE_DEV_USER_ID=

# 推流设置中允许编辑 WHIP 推流地址（调试用；false 时只读置灰）
VITE_PUSH_URL_EDITABLE=true
