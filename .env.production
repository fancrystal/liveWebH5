# Production environment
# WebSocket / WHIP URL 为空时，前端代码会用当前页面的 host 自动拼接
# 浏览器 → wss://<当前域名>/rtmp-relay → 前端 nginx → rtmp-relay Service:14118
VITE_RTMP_WS_URL=

# SaaS 接口基地址（换 token + 云盘业务接口共用），格式 https://host:port
# ⚠️ 生产环境务必填写正确，否则 code 换 token 会失败
VITE_SASS_URL=https://qdd-test.lxi-tech.com:15816

# 信令服务器（连麦功能用，后端未部署，留空即可）
VITE_SIGNAL_URL=

# WHIP 推流地址（SRS 未部署，留空即可）
VITE_WHIP_URL=

# 详细诊断日志（Mixer tick / RTMP chunks/s / 鉴权流程 / 信令决策）
# ⚠️ 当前 .env.production 实际部署到【测试环境】(qdd-test)，故打开便于排查。
#    将来上线真正的正式环境时，请改回 false。
VITE_VERBOSE_LOG=true

# 推流设置中允许编辑 WHIP 推流地址（测试环境排查用；false 时只读置灰）
# ⚠️ 当前 .env.production 实际部署到【测试环境】(qdd-test)，故打开。
#    将来上线真正的正式环境时，请改为 false（地址仍显示但置灰不可改）。
VITE_PUSH_URL_EDITABLE=true
